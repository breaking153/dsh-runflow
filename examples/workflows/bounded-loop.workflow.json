{
  "id": "example-bounded-loop", "name": "Bounded loop and shared state", "version": 1,
  "execution": { "mode": "state-graph", "maxSteps": 20, "initialState": { "count": 0 }, "reducers": { "count": "sum" } },
  "nodes": [
    { "id": "manual", "type": "trigger.manual", "config": {}, "position": { "x": 40, "y": 80 } },
    { "id": "loop", "type": "control.loop", "config": { "maxIterations": 3 }, "position": { "x": 320, "y": 80 } },
    { "id": "increment", "type": "state.update", "config": { "key": "count", "source": "value", "value": 1 }, "position": { "x": 600, "y": 260 } },
    { "id": "read", "type": "state.read", "config": { "path": "count" }, "position": { "x": 600, "y": 40 } },
    { "id": "end", "type": "control.end", "config": {}, "position": { "x": 880, "y": 40 } }
  ],
  "edges": [
    { "from": "manual", "to": "loop", "sourcePort": "output", "targetPort": "input" },
    { "from": "loop", "to": "increment", "sourcePort": "continue", "targetPort": "input" },
    { "from": "increment", "to": "loop", "sourcePort": "output", "targetPort": "input" },
    { "from": "loop", "to": "read", "sourcePort": "done", "targetPort": "input" },
    { "from": "read", "to": "end", "sourcePort": "output", "targetPort": "input" }
  ]
}
