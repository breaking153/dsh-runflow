      { "id": "RF-101", "title": "Improve search", "active": true, "score": 91 },
      { "id": "RF-102", "title": "Update archive", "active": false, "score": 99 },
      { "id": "RF-103", "title": "Repair export", "active": true, "score": 97 },
      { "id": "RF-104", "title": "Polish settings", "active": true, "score": 83 },
      { "id": "RF-105", "title": "Retire endpoint", "active": false, "score": 88 }
