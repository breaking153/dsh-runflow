    { "id": "demo-data-filter", "type": "builtin.filter", "name": "保留有效项 / Filter", "config": { "path": "active", "operator": "equals", "value": true }, "position": { "x": 360, "y": 330 } },
    { "id": "demo-data-sort", "type": "builtin.sort", "name": "分数降序 / Sort", "config": { "path": "score", "order": "desc" }, "position": { "x": 680, "y": 330 } },
    { "id": "demo-data-limit", "type": "builtin.limit", "name": "取前两项 / Top 2", "config": { "maxItems": 2 }, "position": { "x": 1000, "y": 330 } },
    { "id": "demo-data-storage", "type": "storage.write", "name": "保存结果 / Storage", "config": { "collection": "demo-top-items" }, "position": { "x": 1000, "y": 80 } },
    { "id": "demo-data-end", "type": "control.end", "name": "返回回执 / Result", "config": {}, "position": { "x": 1320, "y": 80 } }
