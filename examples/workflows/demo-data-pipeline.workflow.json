  "edges": [
    { "id": "demo-data-start-storage", "from": "demo-data-start", "to": "demo-data-storage", "sourcePort": "output", "targetPort": "flow" },
    { "id": "demo-data-source-filter", "from": "demo-data-source", "to": "demo-data-filter", "sourcePort": "value", "targetPort": "json" },
    { "id": "demo-data-filter-sort", "from": "demo-data-filter", "to": "demo-data-sort", "sourcePort": "json", "targetPort": "json" },
    { "id": "demo-data-sort-limit", "from": "demo-data-sort", "to": "demo-data-limit", "sourcePort": "json", "targetPort": "json" },
    { "id": "demo-data-limit-storage", "from": "demo-data-limit", "to": "demo-data-storage", "sourcePort": "json", "targetPort": "input" },
    { "id": "demo-data-storage-end-flow", "from": "demo-data-storage", "to": "demo-data-end", "sourcePort": "flow", "targetPort": "input" },
    { "id": "demo-data-storage-end-data", "from": "demo-data-storage", "to": "demo-data-end", "sourcePort": "output", "targetPort": "data" }
  ]
