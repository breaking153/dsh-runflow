{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "dsh-runflow": ["./src/index.ts"] },
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "script", "nodes", "tests", "tsdown.config.ts", "vite.config.ts"],
  "exclude": ["src/client", "tests/**/*.client.spec.tsx"]
}
